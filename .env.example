# Copie para .env e ajuste:  cp .env.example .env
# NUNCA commite o .env — ele está no .gitignore e a CI roda gitleaks.

NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# Banco (usado pelo docker compose para criar o Postgres e montar a DATABASE_URL da API)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pedidos
DB_PORT=5433
API_PORT=3000

# Usado quando a API roda fora do Docker (npm run dev) ou nos testes de integração
DATABASE_URL=postgres://pedidos:troque-esta-senha@localhost:5433/pedidos
